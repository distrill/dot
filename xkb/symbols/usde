default partial alphanumeric_keys
xkb_symbols "basic" {
    include "us(basic)"
    include "level3(ralt_switch)"

    name[Group1] = "English (US, German umlauts)";

    key <AC01> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC",
                 [ a, A, adiaeresis, Adiaeresis ] };
    key <AD09> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC",
                 [ o, O, odiaeresis, Odiaeresis ] };
    key <AD07> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC",
                 [ u, U, udiaeresis, Udiaeresis ] };
    key <AC02> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC",
                 [ s, S, ssharp, U1E9E ] };
};
