* {
  white:   #ffffff;
  base:    #191724;
  overlay: #26233a;
  subtle:  #908caa;
  text:    #e0def4;
  pine:    #31748f;
  gold:    #f6c177;
  rose:    #ebbcba;
  iris:    #c4a7e7;
}

message {
  border: none;
}

listview {
  border: none;
}

sidebar {
  border: none;
}

window {
  background-color: var(base);
  padding:          24px;
  border-radius:    4px;
  border-color:     var(subtle);
  border:           1px;
}

entry {
  background-color: var(base);
  text-color:       var(white);
  placeholder:      "";
  cursor:           pointer;
}

prompt {
  text-color: var(subtle);
  underline:  none;
}

listview {
  lines:     3;
  scrollbar: false;
}

element {
  padding:          0px;
  background-color: var(base);
}

element selected {
  text-color: var(gold);
}

element normal.normal,
element alternate.normal,
element normal.active,
element alternate.active {
  background-color: var(base);
}

element selected.normal,
element selected.active {
  text-color:       var(gold);
  background-color: var(base);
}

element-text {
  background-color: var(base);
  text-color:       var(subtle);
}

element-text selected.normal {
  text-color: var(gold);
}

configuration {
  font: "CommitMono Nerd Font Propo 13";
  timeout {
    action: "kb-cancel";
    delay:  0;
  }
  filebrowser {
    directories-first: true;
    sorting-method:    "name";
  }
}
